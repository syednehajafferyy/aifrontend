# Required for Google Gemini AI code generation
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# Required for Anthropic AI code generation (optional fallback)
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key

# Required for Prisma database access.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required for NextAuth sessions.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret